# AgentFactory Gateway — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Alternatively, set these as system environment variables.
#

# ── Required: Slack Tokens ───────────────────────────────────────────
#
# SLACK_BOT_TOKEN (xoxb-...)
#   Bot User OAuth Token from your Slack App.
#   Get it from: Slack App > OAuth & Permissions > Bot User OAuth Token
#
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# SLACK_APP_TOKEN (xapp-...)
#   App-Level Token for Socket Mode.
#   Get it from: Slack App > Basic Information > App-Level Token
#   You must enable Socket Mode first.
#
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── Optional: Python Worker ─────────────────────────────────────────
#
# PYTHON_BIN
#   Path to the Python binary used to run worker.py.
#   Default: python3
#
# PYTHON_BIN=python3

# AF_WORK_DIR
#   Path to the AgentFactory project directory (contains worker.py).
#   Default: $HOME/projects/agentfactory
#
# AF_WORK_DIR=$HOME/projects/agentfactory

# ── Optional: AgentFactory CLI ──────────────────────────────────────
#
# AF_CLI_BIN
#   Path to the 'af' CLI binary (used for task status checks).
#   If not set, the gateway falls back to: python3 cli.py check-task ...
#   Find it with: which af
#
# AF_CLI_BIN=$HOME/.local/bin/af

# ── Optional: LM Studio ─────────────────────────────────────────────
#
# LM_STUDIO_URL
#   URL of the LM Studio local server (used by start.sh health check).
#   Default: http://127.0.0.1:1234
#
# LM_STUDIO_URL=http://127.0.0.1:1234

# ── Optional: Slack User Allowlist ──────────────────────────────────
#
# ALLOWED_USERS
#   Comma-separated list of Slack user IDs allowed to interact with the bot.
#   Leave empty to allow all users in the workspace.
#   Find user IDs: right-click a user > Copy Link > extract the ID.
#
# ALLOWED_USERS=U01ABC123,U02DEF456

# ── Optional: Cline Settings ────────────────────────────────────────
#
# CLINE_TIMEOUT
#   Timeout in seconds for Cline CLI tasks.
#   Default: 300
#
# CLINE_TIMEOUT=300

# CLINE_CWD
#   Working directory for Cline tasks.
#   Default: . (current directory)
#
# CLINE_CWD=.

# ── Optional: Harness Mode ─────────────────────────────────────────
#
# HARNESS_MODE
#   Inject Karpathy's code quality principles (1=true, 0=false).
#   Default: 1
#
# HARNESS_MODE=1
