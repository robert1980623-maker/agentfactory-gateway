# AgentFactory Gateway Configuration
# Copy this file to .env and fill in your values.
#
# Priority: system env vars > .env file > defaults in config.Load()

# Required: Slack credentials
# Get these from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: Python interpreter (default: "python3")
# PYTHON_BIN=/usr/bin/python3

# Optional: AgentFactory CLI binary path
# AF_CLI_BIN=/usr/local/bin/af-cli

# Optional: Working directory for AF CLI and worker script
# AF_WORK_DIR=/path/to/af-workdir
